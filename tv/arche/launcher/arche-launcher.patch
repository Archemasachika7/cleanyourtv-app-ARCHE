@@ -0,0 +1,202 @@
+package com.gathin.tvhome;
+
+import android.content.ActivityNotFoundException;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+import android.net.Uri;
+import android.widget.Toast;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Arche fork: AI assistant tiles placed right after the entertainment apps in the dock, then the money apps
+ * (Angel One, Groww). Each row has its switch in Arche settings. A tile shows the app's own icon when the
+ * app is installed, else a symbol drawn in code. Each tile opens
+ * the assistant's Android app when it is on the TV, and its website in the TV's browser when it is not
+ * (most have no TV app). The launcher itself still never goes online: the browser or the app does.
+ *
+ * config.json "ai_tiles": a list of "Name|package|https://site" strings replaces the default four;
+ * [] turns the tiles off. Each tile's symbol is drawn in code (a monogram on the assistant's colour),
+ * so no artwork ships with the launcher.
+ */
+final class AiTiles {
+    static final String PREFIX = "ai-tile-";
+
+    static final class Spec {
+        final String name, pkg, url;
+        final int top, bottom;
+
+        Spec(String name, String pkg, String url, int top, int bottom) {
+            this.name = name;
+            this.pkg = pkg;
+            this.url = url;
+            this.top = top;
+            this.bottom = bottom;
+        }
+    }
+
+    private static final Spec[] DEFAULTS = {
+            new Spec("Claude", "com.anthropic.claude", "https://claude.ai", 0xFFE08A6A, 0xFFB4513A),
+            new Spec("ChatGPT", "com.openai.chatgpt", "https://chatgpt.com", 0xFF2FB592, 0xFF0D6E57),
+            new Spec("Gemini", "com.google.android.apps.bard", "https://gemini.google.com", 0xFF6F8BFF, 0xFF8B4FD8),
+            new Spec("Perplexity", "ai.perplexity.app.android", "https://www.perplexity.ai", 0xFF33A3B0, 0xFF17616B),
+    };
+
+    /** Arche fork: money apps, after the AI tiles (config.json "money_tiles" in the same form). */
+    private static final Spec[] MONEY = {
+            new Spec("Angel One", "com.msf.angelmobile", "https://www.angelone.in", 0xFF2F6BFF, 0xFF1537A8),
+            new Spec("Groww", "com.nextbillion.groww", "https://groww.in", 0xFF00D09C, 0xFF00876A),
+    };
+
+    private static final int[][] PALETTE = {
+            {0xFFE0A15A, 0xFF9C5A1E}, {0xFF5AA8FF, 0xFF2A5DB8}, {0xFFC86BFF, 0xFF6E2AA8}, {0xFF5AE0A0, 0xFF1E8A5A},
+    };
+
+    private AiTiles() {}
+
+    /**
+     * The tiles to show: the AI row, then the money apps, each from config.json ("ai_tiles",
+     * "money_tiles") or the defaults, and each only while its switch in Arche settings is on.
+     */
+    static List<Spec> specs(Context ctx) {
+        JSONObject json = VibePlayer.readConfig(Config.dir(ctx));
+        List<Spec> out = new ArrayList<>();
+        if (ArcheSettings.on(ctx, ArcheSettings.AI_TILES)) group(json, "ai_tiles", DEFAULTS, out);
+        if (ArcheSettings.on(ctx, ArcheSettings.MONEY_TILES)) group(json, "money_tiles", MONEY, out);
+        return out;
+    }
+
+    private static void group(JSONObject json, String key, Spec[] defaults, List<Spec> out) {
+        JSONArray list = json == null ? null : json.optJSONArray(key);
+        if (list == null) {
+            for (Spec s : defaults) out.add(s);
+            return;
+        }
+        int limit = out.size() + 8;
+        for (int i = 0; i < list.length() && out.size() < limit; i++) {
+            String[] f = list.optString(i, "").split("\\|", -1);
+            if (f.length != 3) continue;
+            String name = f[0].trim(), pkg = f[1].trim(), url = f[2].trim();
+            if (name.isEmpty() || name.length() > 24 || !url.startsWith("https://")) continue;
+            Spec known = null;
+            for (Spec d : DEFAULTS) if (d.pkg.equals(pkg)) known = d;
+            for (Spec d : MONEY) if (d.pkg.equals(pkg)) known = d;
+            int[] c = PALETTE[out.size() % PALETTE.length];
+            out.add(known != null ? new Spec(name, pkg, url, known.top, known.bottom) : new Spec(name, pkg, url, c[0], c[1]));
+        }
+    }
+
+    /** The app's own icon (its real logo) when it is installed on the TV; null when it is not. */
+    static Drawable realIcon(Context ctx, Spec s) {
+        if (s.pkg.isEmpty()) return null;
+        try {
+            return ctx.getPackageManager().getApplicationIcon(s.pkg);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    static ComponentName component(Context ctx, int index) {
+        return new ComponentName(ctx, PREFIX + index);
+    }
+
+    static boolean isTile(ComponentName c) {
+        return c != null && c.getClassName().startsWith(PREFIX);
+    }
+
+    /** Opens the assistant: its app when installed, else its site in the browser, else says what is missing. */
+    static void open(Context ctx, Spec s) {
+        if (!s.pkg.isEmpty()) {
+            Intent app = ctx.getPackageManager().getLeanbackLaunchIntentForPackage(s.pkg);
+            if (app == null) app = ctx.getPackageManager().getLaunchIntentForPackage(s.pkg);
+            if (app != null) {
+                try {
+                    ctx.startActivity(app.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+                    return;
+                } catch (RuntimeException ignored) {
+                    // fall through to the site
+                }
+            }
+        }
+        try {
+            ctx.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(s.url))
+                    .addCategory(Intent.CATEGORY_BROWSABLE).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+        } catch (ActivityNotFoundException e) {
+            Toast.makeText(ctx, ctx.getString(R.string.arche_ai_needs_browser, s.name), Toast.LENGTH_LONG).show();
+        } catch (RuntimeException e) {
+            Toast.makeText(ctx, ctx.getString(R.string.cant_open, s.name), Toast.LENGTH_SHORT).show();
+        }
+    }
+
+    /** The tile's symbol: the assistant's initial on a rounded square in its colours, with a small spark. */
+    static Drawable symbol(Spec s) {
+        return new Symbol(s);
+    }
+
+    private static final class Symbol extends Drawable {
+        private final Spec spec;
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint spark = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF box = new RectF();
+        private final Path star = new Path();
+
+        Symbol(Spec spec) {
+            this.spec = spec;
+            text.setColor(0xFFFFFFFF);
+            text.setTextAlign(Paint.Align.CENTER);
+            text.setTypeface(Typeface.create(Typeface.SANS_SERIF, Typeface.BOLD));
+            spark.setColor(0xF2FFFFFF);
+        }
+
+        @Override
+        public void draw(Canvas canvas) {
+            Rect b = getBounds();
+            float size = Math.min(b.width(), b.height());
+            float left = b.exactCenterX() - size / 2f, top = b.exactCenterY() - size / 2f;
+            box.set(left, top, left + size, top + size);
+            fill.setShader(new LinearGradient(box.left, box.top, box.right, box.bottom, spec.top, spec.bottom, Shader.TileMode.CLAMP));
+            float r = size * 0.24f;
+            canvas.drawRoundRect(box, r, r, fill);
+            text.setTextSize(size * 0.56f);
+            String initial = spec.name.substring(0, 1).toUpperCase(java.util.Locale.ROOT);
+            float y = box.centerY() - (text.descent() + text.ascent()) / 2f;
+            canvas.drawText(initial, box.centerX() - size * 0.04f, y, text);
+            // A four-point spark in the top-right corner: the shared mark of an AI tile.
+            float cx = box.right - size * 0.2f, cy = box.top + size * 0.2f, o = size * 0.11f, i = size * 0.03f;
+            star.reset();
+            star.moveTo(cx, cy - o);
+            star.lineTo(cx + i, cy - i);
+            star.lineTo(cx + o, cy);
+            star.lineTo(cx + i, cy + i);
+            star.lineTo(cx, cy + o);
+            star.lineTo(cx - i, cy + i);
+            star.lineTo(cx - o, cy);
+            star.lineTo(cx - i, cy - i);
+            star.close();
+            canvas.drawPath(star, spark);
+        }
+
+        @Override public void setAlpha(int alpha) { fill.setAlpha(alpha); text.setAlpha(alpha); spark.setAlpha(alpha); }
+        @Override public void setColorFilter(ColorFilter cf) { fill.setColorFilter(cf); }
+        @Override public int getOpacity() { return PixelFormat.TRANSLUCENT; }
+        @Override public int getIntrinsicWidth() { return 192; }
+        @Override public int getIntrinsicHeight() { return 192; }
+    }
+}
