--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/VibePlayer.java
@@ -0,0 +1,207 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Canvas;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.DisplayMetrics;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Arche fork: "vibes", a picture per app. Each app tile shows its own picture behind Home while it has
+ * the focus, so moving left or right through the dock changes the whole screen. The pictures are the
+ * owner's own files in the launcher's files folder, vibes/ (01.jpg, 02.jpg, ...), taken in name order:
+ * the first app gets the first picture, and so on, wrapping round when there are more apps than pictures.
+ * No vibes folder, or an empty one, leaves Home exactly as it was.
+ *
+ * Kept light for 1 GB TVs: one picture is decoded at a time, off the main thread, at screen size in
+ * RGB_565 (a hardware bitmap where the TV allows), only once the focus has rested for the delay, so
+ * scrolling fast decodes nothing in between; the picture it replaces is released after the crossfade.
+ *
+ * config.json keys: "vibe_dim" 0-90 (darkening painted into each picture, default 35, so names and the
+ * clock stay readable) and "vibe_delay_ms" 0-2000 (default 220).
+ */
+final class VibePlayer {
+    static final String DIR = "vibes";
+    private static final long FADE_MS = 260;
+
+    private final FrameLayout root;
+    private final ImageView front;
+    private final ImageView back;
+    private final List<File> files = new ArrayList<>();
+    private final ExecutorService decoder = Executors.newSingleThreadExecutor();
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final int width, height, dimColor;
+    private final long delayMs;
+    private Bitmap current;
+    private int shownIndex = -1;
+    private int wanted = -1;
+    private int generation;
+    private boolean closed;
+
+    /** {@code at}: the child index just above the theme's wallpaper view (0 when the theme draws none). */
+    VibePlayer(Context context, FrameLayout root, int at) {
+        this.root = root;
+        File dir = Config.dir(context);
+        File[] images = dir == null ? null : new File(dir, DIR).listFiles((d, name) -> ThemeFiles.collectionImage(name));
+        if (images != null && ArcheSettings.on(context, ArcheSettings.VIBES)) {
+            Arrays.sort(images, (a, b) -> a.getName().compareToIgnoreCase(b.getName()));
+            for (File f : images) if (f.isFile() && f.length() > 0) files.add(f);
+        }
+        JSONObject json = readConfig(dir);
+        int dim = clamp(json == null ? 35 : json.optInt("vibe_dim", 35), 0, 90);
+        dimColor = dim > 0 ? (dim * 255 / 100) << 24 : 0;
+        delayMs = clamp(json == null ? 220 : json.optInt("vibe_delay_ms", 220), 0, 2000);
+        DisplayMetrics metrics = context.getResources().getDisplayMetrics();
+        width = metrics.widthPixels;
+        height = metrics.heightPixels;
+        back = makeImage(context);
+        front = makeImage(context);
+        if (!files.isEmpty()) {
+            // Just above the theme's wallpaper, under the sky, glow, grid and everything else.
+            at = Math.max(0, Math.min(at, root.getChildCount()));
+            root.addView(back, at, matchParent());
+            root.addView(front, at + 1, matchParent());
+        }
+    }
+
+    boolean enabled() {
+        return !files.isEmpty() && !closed;
+    }
+
+    /** A tile at this adapter position took the focus. */
+    void focus(int position) {
+        if (!enabled() || position < 0) return;
+        int index = position % files.size();
+        wanted = index;
+        if (index == shownIndex) return;
+        final int gen = ++generation;
+        main.removeCallbacksAndMessages(null);
+        main.postDelayed(() -> load(index, gen), shownIndex < 0 ? 0 : delayMs);
+    }
+
+    private void load(int index, int gen) {
+        if (closed || gen != generation) return;
+        File file = files.get(index);
+        decoder.execute(() -> {
+            Bitmap bitmap = decode(file);
+            main.post(() -> {
+                if (closed || gen != generation || index != wanted) {
+                    if (bitmap != null) bitmap.recycle();
+                    return;
+                }
+                if (bitmap == null) return;
+                show(bitmap, index);
+            });
+        });
+    }
+
+    private void show(Bitmap bitmap, int index) {
+        Bitmap old = current;
+        current = bitmap;
+        shownIndex = index;
+        // The old picture goes behind, the new one fades in over it; then the old one is released.
+        back.setImageDrawable(front.getDrawable());
+        back.setAlpha(1f);
+        front.animate().cancel();
+        front.setImageBitmap(bitmap);
+        front.setAlpha(0f);
+        front.animate().alpha(1f).setDuration(FADE_MS).withEndAction(() -> {
+            back.setImageDrawable(null);
+            if (old != null && old != current) main.postDelayed(old::recycle, 300);
+        }).start();
+        root.setBackground(null);
+    }
+
+    /** Home hidden and memory short: drop the picture; the next focus loads it again. */
+    void releaseForMemoryPressure() {
+        if (current == null) return;
+        generation++;
+        front.setImageDrawable(null);
+        back.setImageDrawable(null);
+        current = null;
+        shownIndex = -1;
+    }
+
+    void close() {
+        closed = true;
+        main.removeCallbacksAndMessages(null);
+        decoder.shutdownNow();
+    }
+
+    private Bitmap decode(File file) {
+        try {
+            BitmapFactory.Options options = new BitmapFactory.Options();
+            options.inJustDecodeBounds = true;
+            BitmapFactory.decodeFile(file.getPath(), options);
+            int w = options.outWidth, h = options.outHeight;
+            if (w <= 0 || h <= 0) return null;
+            int sample = WallpaperSize.sampleSize(w, h, width, height);
+            if (!WallpaperSize.accepted(w / sample, h / sample)) return null;
+            options.inJustDecodeBounds = false;
+            options.inSampleSize = sample;
+            options.inPreferredConfig = Bitmap.Config.RGB_565;
+            options.inMutable = dimColor != 0;
+            Bitmap decoded = BitmapFactory.decodeFile(file.getPath(), options);
+            if (decoded == null) return null;
+            if (dimColor != 0) new Canvas(decoded).drawColor(dimColor);
+            Bitmap gpu = decoded.copy(Bitmap.Config.HARDWARE, false);
+            if (gpu == null) return decoded;
+            decoded.recycle();
+            return gpu;
+        } catch (Exception | OutOfMemoryError failure) {
+            return null;
+        }
+    }
+
+    private static ImageView makeImage(Context context) {
+        ImageView image = new ImageView(context);
+        image.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        image.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        image.setFocusable(false);
+        return image;
+    }
+
+    private static FrameLayout.LayoutParams matchParent() {
+        return new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+    }
+
+    private static int clamp(int v, int lo, int hi) {
+        return Math.max(lo, Math.min(hi, v));
+    }
+
+    /** config.json from the theme folder, or null. */
+    static JSONObject readConfig(File dir) {
+        if (dir == null) return null;
+        File f = new File(dir, Config.FILE_NAME);
+        if (!f.isFile() || f.length() > 512 * 1024) return null;
+        try (FileInputStream in = new FileInputStream(f)) {
+            byte[] b = new byte[(int) f.length()];
+            int off = 0;
+            while (off < b.length) {
+                int n = in.read(b, off, b.length - off);
+                if (n < 0) break;
+                off += n;
+            }
+            return new JSONObject(new String(b, 0, off, StandardCharsets.UTF_8));
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
