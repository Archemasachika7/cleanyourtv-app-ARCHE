@@ -0,0 +1,135 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.os.Bundle;
+import android.util.TypedValue;
+import android.view.ContextThemeWrapper;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Arche fork: the remote-friendly page for every Arche extra, opened from Launcher settings. Each row
+ * switches one extra on or off; the widgets start off. "Return to default" puts every switch back,
+ * and "Original look" turns every extra off for the plain Clean Your TV home screen.
+ */
+public final class ArcheSettingsActivity extends Activity {
+    @Override
+    protected void attachBaseContext(android.content.Context base) {
+        super.attachBaseContext(LauncherLocale.wrap(base));
+    }
+
+    private final List<TextView> rows = new ArrayList<>();
+    private final List<ArcheSettings.Switch> switches = new ArrayList<>();
+    private float dp;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        dp = getResources().getDisplayMetrics().density;
+        ScrollView scroll = new ScrollView(this);
+        scroll.setBackgroundColor(0xFF101419);
+        scroll.setFillViewport(true);
+        LinearLayout list = new LinearLayout(this);
+        list.setOrientation(LinearLayout.VERTICAL);
+        int side = Math.round(72 * dp), top = Math.round(38 * dp);
+        list.setPadding(side, top, side, top);
+        scroll.addView(list, new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        list.addView(text(getString(R.string.arche_settings), 34, 0xFFFFFFFF, 0));
+        list.addView(text(getString(R.string.arche_settings_hint), 15, 0xFFACB8C1, 8));
+        for (ArcheSettings.Switch s : ArcheSettings.EXTRAS) list.addView(switchRow(s, rows.isEmpty() ? 26 : 10));
+        list.addView(text(getString(R.string.arche_widgets_title), 22, 0xFFFFFFFF, 30));
+        list.addView(text(getString(R.string.arche_widgets_hint), 15, 0xFFACB8C1, 6));
+        boolean first = true;
+        for (ArcheSettings.Switch s : ArcheSettings.WIDGETS) {
+            list.addView(switchRow(s, first ? 14 : 10));
+            first = false;
+        }
+
+        TextView reset = row(getString(R.string.arche_reset), 34);
+        reset.setOnClickListener(v -> new AlertDialog.Builder(this)
+                .setTitle(R.string.arche_reset)
+                .setMessage(R.string.arche_reset_message)
+                .setPositiveButton(R.string.arche_reset_yes, (d, w) -> {
+                    ArcheSettings.reset(this);
+                    setResult(RESULT_OK);
+                    refresh();
+                    Toast.makeText(this, R.string.arche_reset_done, Toast.LENGTH_SHORT).show();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show());
+        list.addView(reset);
+
+        TextView original = row(getString(R.string.arche_original), 10);
+        original.setOnClickListener(v -> {
+            for (ArcheSettings.Switch s : ArcheSettings.EXTRAS) ArcheSettings.set(this, s, false);
+            for (ArcheSettings.Switch s : ArcheSettings.WIDGETS) ArcheSettings.set(this, s, false);
+            setResult(RESULT_OK);
+            refresh();
+            Toast.makeText(this, R.string.arche_original_done, Toast.LENGTH_SHORT).show();
+        });
+        list.addView(original);
+        list.addView(text(getString(R.string.arche_original_hint), 14, 0xFFACB8C1, 7));
+
+        setContentView(scroll);
+        refresh();
+        if (!rows.isEmpty()) rows.get(0).requestFocus();
+    }
+
+    private TextView switchRow(ArcheSettings.Switch s, int marginTopDp) {
+        TextView row = row("", marginTopDp);
+        rows.add(row);
+        switches.add(s);
+        row.setOnClickListener(v -> {
+            ArcheSettings.set(this, s, !ArcheSettings.on(this, s));
+            setResult(RESULT_OK);
+            refresh();
+        });
+        return row;
+    }
+
+    private void refresh() {
+        for (int i = 0; i < rows.size(); i++) {
+            ArcheSettings.Switch s = switches.get(i);
+            boolean on = ArcheSettings.on(this, s);
+            rows.get(i).setText(getString(R.string.arche_switch_row, getString(s.label),
+                    getString(on ? R.string.arche_on : R.string.arche_off)));
+        }
+    }
+
+    /** A focusable row in Launcher settings' own style (styles.xml SettingsRow). */
+    private TextView row(String label, int marginTopDp) {
+        TextView row = new TextView(new ContextThemeWrapper(this, R.style.SettingsRow), null, 0);
+        row.setText(label);
+        row.setFocusable(true);
+        row.setClickable(true);
+        row.setBackgroundResource(R.drawable.settings_choice_bg);
+        row.setTextColor(0xFFFFFFFF);
+        row.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18);
+        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
+        int pad = Math.round(18 * dp);
+        row.setPadding(pad, 0, pad, 0);
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, Math.round(52 * dp));
+        lp.topMargin = Math.round(marginTopDp * dp);
+        row.setLayoutParams(lp);
+        return row;
+    }
+
+    private TextView text(String value, int sp, int color, int marginTopDp) {
+        TextView t = new TextView(this);
+        t.setText(value);
+        t.setTextColor(color);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.topMargin = Math.round(marginTopDp * dp);
+        t.setLayoutParams(lp);
+        return t;
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/ArcheWidgets.java b/launcher/app/src/main/java/com/gathin/tvhome/ArcheWidgets.java
new file mode 100644
index 00000000..c5610887
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/ArcheWidgets.java
@@ -0,0 +1,238 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.time.DayOfWeek;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+import java.time.format.TextStyle;
+import java.time.temporal.ChronoUnit;
+import java.time.temporal.IsoFields;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Arche fork: small glass widgets side by side on the right of Home, in the band between the clock and
+ * the dock (each 200dp wide, so all four fit a 1080p TV). All are off until turned
+ * on in Arche settings, need nothing from the internet (the launcher has no network access), and update
+ * once a minute while Home is on screen.
+ *
+ * World clock: three cities (config.json "world_clocks": IANA zone ids, e.g. "Europe/London").
+ * Calendar: today's day, date, week and day of the year. Day: how far through the day and the week.
+ * Line of the day: one short line, a new one each day.
+ */
+final class ArcheWidgets {
+    private static final long MINUTE_MS = 60_000L;
+    private static final String[] LINES = {
+            "Small steps, every day.", "Make the next hour count.", "Rest is part of the work.",
+            "Start before you feel ready.", "Done is better than perfect.", "Be the calm in the room.",
+            "Curiosity is a superpower.", "One thing at a time.", "Leave it better than you found it.",
+            "Hard choices, easy life.", "Learn something small today.", "Drink water. Stand up. Breathe.",
+            "Focus is saying no to good ideas.", "Your future self is watching.", "Kindness is never wasted.",
+            "Show up, even on slow days.", "Progress, not perfection.", "Keep the promise you made to yourself.",
+            "The best time is now.", "Every master was once a beginner.", "Ask one good question today.",
+    };
+
+    private final Context ctx;
+    private final LinearLayout column;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final List<Runnable> updaters = new ArrayList<>();
+    private final float dp;
+    private boolean running;
+
+    private final Runnable tick = new Runnable() {
+        @Override public void run() {
+            for (Runnable r : updaters) r.run();
+            if (running) handler.postDelayed(this, MINUTE_MS - System.currentTimeMillis() % MINUTE_MS + 50);
+        }
+    };
+
+    /** Adds the switched-on widgets to Home's root; null when none is on (nothing is added then). */
+    static ArcheWidgets attach(Context ctx, FrameLayout root) {
+        if (!ArcheSettings.anyWidget(ctx)) return null;
+        return new ArcheWidgets(ctx, root);
+    }
+
+    private ArcheWidgets(Context ctx, FrameLayout root) {
+        this.ctx = ctx;
+        dp = ctx.getResources().getDisplayMetrics().density;
+        column = new LinearLayout(ctx);
+        column.setOrientation(LinearLayout.HORIZONTAL);
+        column.setFocusable(false);
+        column.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_YES);
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP | Gravity.END);
+        lp.topMargin = Math.round(118 * dp);
+        lp.setMarginEnd(Math.round(56 * dp));
+        if (ArcheSettings.on(ctx, ArcheSettings.W_WORLD)) worldClock();
+        if (ArcheSettings.on(ctx, ArcheSettings.W_CALENDAR)) calendar();
+        if (ArcheSettings.on(ctx, ArcheSettings.W_DAY)) day();
+        if (ArcheSettings.on(ctx, ArcheSettings.W_LINE)) line();
+        root.addView(column, lp);
+    }
+
+    void start() {
+        if (running) return;
+        running = true;
+        handler.removeCallbacks(tick);
+        tick.run();
+    }
+
+    void stop() {
+        running = false;
+        handler.removeCallbacks(tick);
+    }
+
+    // ---- the widgets -------------------------------------------------------------------------------
+
+    private void worldClock() {
+        LinearLayout card = card(ctx.getString(R.string.arche_w_world));
+        List<ZoneId> zones = zones();
+        List<TextView> times = new ArrayList<>();
+        for (ZoneId z : zones) {
+            LinearLayout line = new LinearLayout(ctx);
+            line.setOrientation(LinearLayout.HORIZONTAL);
+            TextView city = label(cityName(z), 16, 0xD9FFFFFF);
+            city.setLayoutParams(new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+            TextView time = label("", 18, 0xFFFFFFFF);
+            line.addView(city);
+            line.addView(time);
+            line.setPadding(0, Math.round(3 * dp), 0, Math.round(3 * dp));
+            card.addView(line);
+            times.add(time);
+        }
+        DateTimeFormatter f = DateTimeFormatter.ofPattern("HH:mm  EEE", Locale.getDefault());
+        updaters.add(() -> {
+            for (int i = 0; i < zones.size(); i++) times.get(i).setText(ZonedDateTime.now(zones.get(i)).format(f));
+        });
+    }
+
+    private void calendar() {
+        LinearLayout card = card(ctx.getString(R.string.arche_w_calendar));
+        TextView big = label("", 24, 0xFFFFFFFF);
+        TextView date = label("", 16, 0xD9FFFFFF);
+        TextView small = label("", 14, 0xA6FFFFFF);
+        card.addView(big);
+        card.addView(date);
+        card.addView(small);
+        updaters.add(() -> {
+            LocalDate d = LocalDate.now();
+            big.setText(d.getDayOfWeek().getDisplayName(TextStyle.FULL, Locale.getDefault()));
+            date.setText(d.format(DateTimeFormatter.ofPattern("d MMMM yyyy", Locale.getDefault())));
+            small.setText(ctx.getString(R.string.arche_w_calendar_line, d.get(IsoFields.WEEK_OF_WEEK_BASED_YEAR),
+                    d.getDayOfYear(), d.lengthOfYear()));
+        });
+    }
+
+    private void day() {
+        LinearLayout card = card(ctx.getString(R.string.arche_w_day));
+        TextView pct = label("", 16, 0xFFFFFFFF);
+        ProgressBar bar = new ProgressBar(ctx, null, android.R.attr.progressBarStyleHorizontal);
+        bar.setMax(1000);
+        bar.setLayoutParams(new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, Math.round(8 * dp)));
+        TextView week = label("", 14, 0xA6FFFFFF);
+        card.addView(pct);
+        card.addView(bar);
+        card.addView(week);
+        updaters.add(() -> {
+            LocalDateTime now = LocalDateTime.now();
+            int minutes = now.getHour() * 60 + now.getMinute();
+            bar.setProgress(minutes * 1000 / 1440);
+            pct.setText(ctx.getString(R.string.arche_w_day_line, minutes * 100 / 1440));
+            DayOfWeek dow = now.getDayOfWeek();
+            if (dow == DayOfWeek.SATURDAY || dow == DayOfWeek.SUNDAY) {
+                week.setText(R.string.arche_w_weekend_now);
+            } else {
+                long days = ChronoUnit.DAYS.between(now.toLocalDate(), now.toLocalDate().with(java.time.temporal.TemporalAdjusters.next(DayOfWeek.SATURDAY)));
+                week.setText(ctx.getResources().getQuantityString(R.plurals.arche_w_weekend_in, (int) days, (int) days));
+            }
+        });
+    }
+
+    private void line() {
+        LinearLayout card = card(ctx.getString(R.string.arche_w_line));
+        TextView text = label("", 16, 0xFFFFFFFF);
+        card.addView(text);
+        updaters.add(() -> text.setText(LINES[(int) Math.floorMod(LocalDate.now().toEpochDay(), (long) LINES.length)]));
+    }
+
+    // ---- building blocks ---------------------------------------------------------------------------
+
+    /** A frosted-glass card with a small title, added to the column. */
+    private LinearLayout card(String title) {
+        LinearLayout card = new LinearLayout(ctx);
+        card.setOrientation(LinearLayout.VERTICAL);
+        int pad = Math.round(16 * dp);
+        card.setPadding(pad, Math.round(12 * dp), pad, Math.round(14 * dp));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setCornerRadius(20 * dp);
+        bg.setColor(0x2EFFFFFF);
+        bg.setStroke(Math.max(1, Math.round(dp)), 0x40FFFFFF);
+        card.setBackground(bg);
+        card.addView(label(title, 13, 0xA6FFFFFF));
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(Math.round(200 * dp), ViewGroup.LayoutParams.WRAP_CONTENT);
+        if (column.getChildCount() > 0) lp.setMarginStart(Math.round(12 * dp));
+        column.addView(card, lp);
+        return card;
+    }
+
+    private TextView label(String value, int sp, int color) {
+        TextView t = new TextView(ctx);
+        t.setText(value);
+        t.setTextColor(color);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setShadowLayer(4 * dp, 0, dp, 0x99000000);
+        t.setFocusable(false);
+        try {
+            t.setTypeface(UiFont.get(ctx, R.string.font_regular));
+        } catch (Exception ignored) {
+            // the system font is fine
+        }
+        return t;
+    }
+
+    private List<ZoneId> zones() {
+        List<ZoneId> out = new ArrayList<>();
+        JSONObject json = VibePlayer.readConfig(Config.dir(ctx));
+        JSONArray list = json == null ? null : json.optJSONArray("world_clocks");
+        if (list != null) {
+            for (int i = 0; i < list.length() && out.size() < 4; i++) {
+                try {
+                    out.add(ZoneId.of(list.optString(i, "").trim()));
+                } catch (RuntimeException ignored) {
+                    // not a zone id: skip it
+                }
+            }
+        }
+        if (out.isEmpty()) {
+            out.add(ZoneId.of("Europe/London"));
+            out.add(ZoneId.of("America/New_York"));
+            out.add(ZoneId.of("Asia/Tokyo"));
+        }
+        return out;
+    }
+
+    private static String cityName(ZoneId zone) {
+        String id = zone.getId();
+        int slash = id.lastIndexOf('/');
+        return (slash >= 0 ? id.substring(slash + 1) : id).replace('_', ' ');
+    }
+}
