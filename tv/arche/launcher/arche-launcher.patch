@@ -0,0 +1,68 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/**
+ * Arche fork: the on-TV switches for every Arche extra, kept with the other Launcher settings
+ * (Config.SETTINGS_NAME) so Home rebuilds when one changes. "Return to default" removes them all.
+ */
+final class ArcheSettings {
+    /** One switch: its preference key, its name on the settings page and its default. */
+    static final class Switch {
+        final String key;
+        final int label;
+        final boolean def;
+
+        Switch(String key, int label, boolean def) {
+            this.key = key;
+            this.label = label;
+            this.def = def;
+        }
+    }
+
+    static final Switch AI_TILES = new Switch("arche_ai_tiles", R.string.arche_set_ai, true);
+    static final Switch MONEY_TILES = new Switch("arche_money_tiles", R.string.arche_set_money, true);
+    static final Switch VIBES = new Switch("arche_vibes", R.string.arche_set_vibes, true);
+    static final Switch SOUND = new Switch("arche_startup_sound", R.string.arche_set_sound, true);
+    static final Switch W_WORLD = new Switch("arche_w_world", R.string.arche_w_world, false);
+    static final Switch W_CALENDAR = new Switch("arche_w_calendar", R.string.arche_w_calendar, false);
+    static final Switch W_DAY = new Switch("arche_w_day", R.string.arche_w_day, false);
+    static final Switch W_LINE = new Switch("arche_w_line", R.string.arche_w_line, false);
+
+    /** The page's rows, in order: the tiles and extras first, then the widgets (off until turned on). */
+    static final Switch[] EXTRAS = {AI_TILES, MONEY_TILES, VIBES, SOUND};
+    static final Switch[] WIDGETS = {W_WORLD, W_CALENDAR, W_DAY, W_LINE};
+
+    private ArcheSettings() {}
+
+    private static SharedPreferences prefs(Context ctx) {
+        return ctx.getApplicationContext().getSharedPreferences(Config.SETTINGS_NAME, Context.MODE_PRIVATE);
+    }
+
+    static boolean on(Context ctx, Switch s) {
+        return prefs(ctx).getBoolean(s.key, s.def);
+    }
+
+    static boolean anyWidget(Context ctx) {
+        for (Switch s : WIDGETS) if (on(ctx, s)) return true;
+        return false;
+    }
+
+    static void set(Context ctx, Switch s, boolean value) {
+        bump(prefs(ctx).edit().putBoolean(s.key, value), ctx);
+    }
+
+    /** Every Arche switch back to its default. */
+    static void reset(Context ctx) {
+        SharedPreferences.Editor e = prefs(ctx).edit();
+        for (Switch s : EXTRAS) e.remove(s.key);
+        for (Switch s : WIDGETS) e.remove(s.key);
+        bump(e, ctx);
+    }
+
+    /** Saves and moves Launcher settings' change count, so Home rebuilds when it next resumes. */
+    private static void bump(SharedPreferences.Editor e, Context ctx) {
+        e.putLong(Config.SETTINGS_REVISION_KEY, prefs(ctx).getLong(Config.SETTINGS_REVISION_KEY, 0) + 1).apply();
+    }
+}
